# Keep text files consistent between Windows and macOS.
* text=auto

*.cs text eol=lf
*.py text eol=lf
*.shader text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.ps1 text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.inputactions text eol=lf
*.scenetemplate text eol=lf
Tools/Distribution/macOS/*.command text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

# Never attempt text conversion for common binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.psd binary
*.ttf binary
*.otf binary
*.onnx binary
*.task binary
*.dll binary
*.exe binary
